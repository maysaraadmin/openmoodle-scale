pipeline {
  agent { label 'docker-build' }
  environment {
    REGISTRY = 'registry.openmoodle.local'
    IMAGE_MOODLE = "${REGISTRY}/openmoodle/moodle-app"
    IMAGE_NGINX = "${REGISTRY}/openmoodle/moodle-nginx"
    AWS_DEFAULT_REGION = 'us-east-1'
  }
  stages {
    stage('Lint') {
      steps {
        sh 'python3 -m yamllint -d relaxed .'
        sh 'terraform fmt -check=true -recursive tofu/'
      }
    }
    stage('Validate') {
      steps {
        sh 'helm dependency build helm/openmoodle'
        sh 'helm lint helm/openmoodle'
        sh 'helm template openmoodle-prod helm/openmoodle -f helm/openmoodle/values.yaml -f helm/openmoodle/values-staging.yaml > rendered.yaml'
        sh 'grep -q "change-me" rendered.yaml && exit 1'
        sh 'docker build -t ${IMAGE_MOODLE}:${IMAGE_TAG} -f docker/moodle/Dockerfile docker/moodle'
        sh 'docker build -t ${IMAGE_NGINX}:${IMAGE_TAG} -f docker/nginx/Dockerfile docker/nginx'
      }
    }
    stage('Security Scan') {
      steps {
        sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --severity HIGH,CRITICAL ${IMAGE_MOODLE}:${IMAGE_TAG} || exit 1'
        sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --severity HIGH,CRITICAL ${IMAGE_NGINX}:${IMAGE_TAG} || exit 1'
      }
    }
    stage('Sign Images') {
      when { branch 'main' }
      steps {
        script {
          sh '''
            COSIGN_EXPERIMENTAL=1 cosign sign --yes ${IMAGE_MOODLE}:${IMAGE_TAG}
            COSIGN_EXPERIMENTAL=1 cosign sign --yes ${IMAGE_NGINX}:${IMAGE_TAG}
          '''
        }
      }
    }
    stage('Publish') {
      steps {
        script {
          sh 'docker push ${IMAGE_MOODLE}:${IMAGE_TAG}'
          sh 'docker push ${IMAGE_NGINX}:${IMAGE_TAG}'
          env.MOODLE_DIGEST = sh(script: "docker inspect --format='{{index .RepoDigests 0}}' ${IMAGE_MOODLE}:${IMAGE_TAG}", returnStdout: true).trim()
          env.NGINX_DIGEST = sh(script: "docker inspect --format='{{index .RepoDigests 0}}' ${IMAGE_NGINX}:${IMAGE_TAG}", returnStdout: true).trim()
        }
      }
    }
    stage('Load Test') {
      when { branch 'main' }
      steps {
        script {
          sh 'k6 run -e BASE_URL=https://moodle.example.com scripts/load-test.js'
        }
      }
    }
    stage('Deploy') {
      when { branch 'main' }
      environment {
        KUBECONFIG = credentials('kubeconfig-prod')
      }
      steps {
        sh 'helm upgrade --install openmoodle-prod helm/openmoodle --namespace moodle-prod --create-namespace -f helm/openmoodle/values.yaml -f helm/openmoodle/values-prod.yaml --set moodle.image.tag=${MOODLE_DIGEST} --set moodle.nginx.tag=${NGINX_DIGEST} --wait --atomic --timeout 20m'
      }
    }
  }
  post { always { sh 'docker system prune -f || true' } }
}
